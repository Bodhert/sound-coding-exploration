## sync in ableton by bar.
##| live_loop :met do
##|   ##| current_bpm
##|   ##| we can play with parameters
##|   ##| link_sync 7, 2
##|   link_sync
##|   puts tick+1 % 32
##|   play 60
##|   sleep 1
##| end

live_loop :orchestator do
  link_sync
  ##| bar = tick + 1
  ##| dbg bar
  bar = 0 + tick + 1
  if bar == 1
    midi_note_on 0, port: "iac_driver_bus_1", channel: 1
  elsif bar == 2
    midi_note_on 1, port: "iac_driver_bus_1", channel: 1
  elsif bar == 8
    midi_note_on 3, port: "iac_driver_bus_1", channel: 1
  elsif bar == 10
    midi_note_on 5, port: "iac_driver_bus_1", channel: 1
  elsif bar == 12
    midi_note_on 7, port: "iac_driver_bus_1", channel: 1
  elsif bar == 13
    midi_note_on 4, port: "iac_driver_bus_1", channel: 1
  elsif bar == 14
    midi_note_on 100, port: "iac_driver_bus_1", channel: 1
    midi_note_on 8, port: "iac_driver_bus_1", channel: 1
  elsif bar == 16
    midi_note_on 9, port: "iac_driver_bus_1", channel: 1
  elsif bar == 17
    midi_note_on 10, port: "iac_driver_bus_1", channel: 1
  elsif bar == 18
    midi_note_on 99, port: "iac_driver_bus_1", channel: 1
    midi_note_on 98, port: "iac_driver_bus_1", channel: 1
  end
  puts bar
  sleep 1
end



