#-- buffer 1
# 1. Definimos un nodo vacío para el bombo
# Esto servirá como la "señal de control"
##| set :kick_node, nil

live_loop :musica_de_fondo do
  # El compresor envuelve al bajo o sintetizador
  # 'sidechain_node' apunta a la señal que queremos que mande
  
  # Wait for a MIDI note-on event from any device or channel
  note, velocity = sync "/midi*/*/*/note_on"
  puts note
  
  # Play the incoming note using an internal Sonic Pi synth
  synth :prophet, note: note, amp: velocity / 127.0
  with_fx :compressor, amp: 1.5, low_shelf: 0.1 do
    use_synth :saw
    play_chord note, release: 0.5, cutoff: 80
    sleep 0.5
  end
end

live_loop :midi_in do
  use_real_time # Reduces audio latency
  
  # Wait for a MIDI note-on event from any device or channel
  note, velocity = sync "/midi*/"
  
  puts note
  # Play the incoming note using an internal Sonic Pi synth
  synth :prophet, note: note, amp: velocity / 127.0
end


